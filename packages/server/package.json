{
	"name": "@pi-agent-web/server",
	"version": "0.1.0",
	"description": "Supervisor gateway for Pi Agent Web with REST API and WebSocket relay.",
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"start": "node dist/main.js",
		"prepack": "pnpm build",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:smoke": "tsx test/smoke.ts",
		"test:e2e": "tsx test/e2e-conversation.ts",
		"lint": "biome check ."
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@pi-agent-web/protocol": "workspace:*",
		"@hono/node-server": "^1.14.0",
		"@hono/node-ws": "^1.1.0",
		"hono": "^4.7.0",
		"proper-lockfile": "^4.1.2",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@types/node": "^24.0.0",
		"@types/proper-lockfile": "^4.1.4",
		"@types/ws": "^8.18.0",
		"tsx": "^4.19.0",
		"typescript": "^5.9.0",
		"vitest": "^4.0.0"
	}
}
