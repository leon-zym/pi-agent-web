{
	"name": "@pi-agent-web/protocol",
	"version": "0.1.0",
	"description": "Browser-safe DTOs and runtime guards for Pi Agent Web",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leon-zym/pi-agent-web.git",
		"directory": "packages/protocol"
	},
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"scripts": {
		"prepack": "pnpm build",
		"build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"bench:schema": "vitest bench test/runtime-schema.bench.ts --run",
		"test": "vitest run",
		"lint": "biome check ."
	},
	"dependencies": {
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"typescript": "^5.9.0",
		"vitest": "^4.0.0"
	}
}
