{
	"name": "@pi-agent-web/cli",
	"version": "0.1.0",
	"description": "Local single-command launcher for Pi Agent Web",
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"bin": {
		"pi-web": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"start": "node dist/cli.js",
		"prepack": "pnpm build",
		"build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"lint": "biome check ."
	},
	"dependencies": {
		"@pi-agent-web/server": "workspace:*",
		"@pi-agent-web/ui": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0",
		"vitest": "^4.0.0"
	}
}
