{
	"name": "pi-agent-web",
	"version": "0.1.0",
	"private": true,
	"description": "A local web workbench for Pi Coding Agent's RPC mode with a supervisor gateway and browser UI.",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @pi-agent-web/protocol build && pnpm --parallel --filter @pi-agent-web/server --filter @pi-agent-web/ui dev",
		"dev:ui": "pnpm --filter @pi-agent-web/protocol build && pnpm --filter @pi-agent-web/ui dev",
		"dev:server": "pnpm --filter @pi-agent-web/protocol build && pnpm --filter @pi-agent-web/server dev",
		"build": "pnpm -r build && pnpm check:bundle",
		"test": "pnpm --filter @pi-agent-web/protocol build && pnpm --filter @pi-agent-web/server build && pnpm -r test",
		"test:smoke": "pnpm --filter @pi-agent-web/server test:smoke",
		"test:compat": "pnpm --filter @pi-agent-web/protocol build && pnpm --filter @pi-agent-web/server test:compat",
		"test:e2e": "pnpm test:browser",
		"test:e2e:real": "pnpm --filter @pi-agent-web/server test:e2e",
		"test:browser": "pnpm build && playwright test --config tests/e2e/playwright.config.ts",
		"bench:representative": "node scripts/run-performance-benchmarks.mjs representative",
		"bench:stress": "node scripts/run-performance-benchmarks.mjs stress",
		"test:bench-validator": "node --test scripts/performance-benchmark-validator.test.mjs",
		"test:release-bundle": "node --test scripts/release-bundle.test.mjs scripts/package-smoke.test.mjs",
		"bundle:candidate": "node scripts/create-release-bundle.mjs --candidate",
		"lint": "pnpm -r lint && biome check package.json scripts tests/e2e && node scripts/check-style.mjs && node scripts/check-docs.mjs",
		"check:bundle": "node scripts/check-ui-bundle-budget.mjs",
		"check:style": "node scripts/check-style.mjs",
		"check:docs": "node scripts/check-docs.mjs",
		"typecheck": "pnpm --filter @pi-agent-web/protocol build && pnpm --filter @pi-agent-web/server build && pnpm -r typecheck && pnpm typecheck:e2e",
		"typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
		"verify": "pnpm lint && pnpm typecheck && pnpm test:bench-validator && pnpm test && pnpm build",
		"test:pack": "node scripts/pack-smoke.mjs",
		"start": "pnpm --filter @pi-agent-web/cli start"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@playwright/test": "^1.62.1",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	},
	"packageManager": "pnpm@11.21.0"
}
