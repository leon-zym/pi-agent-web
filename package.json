{
  "name": "pi-agent-web",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Coding Agent RPC 模式的现代 Web 工作台（Headless Agent Web UI + Supervisor Gateway）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pi-agent-web/server --filter @pi-agent-web/ui dev",
    "dev:ui": "pnpm --filter @pi-agent-web/ui dev",
    "dev:server": "pnpm --filter @pi-agent-web/server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @pi-agent-web/cli start"
  },
  "packageManager": "pnpm@11.21.0"
}
